# Settings of the contact and donation API. Copy this file to .env (never commit .env), or set the same
# variables in the web host's control panel. Variables set by the host win over this file.
# Check the result with:  php bin/check.php

# local, testing, staging or production. Anything else counts as production.
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
# Only needed when the API is not at the root of its address, for example /api
APP_BASE_PATH=
# Websites allowed to call the API, comma-separated, exactly as in the browser's address bar (no path).
# Include the address of the website itself, even when it is the same server.
CORS_ALLOWED_ORIGINS=https://example.github.io,https://anamayashram.org
# Behind a CDN or proxy, the header that carries the visitor's address (for example CF-Connecting-IP). Leave empty otherwise.
TRUSTED_IP_HEADER=

# Where files are kept. Prefer folders OUTSIDE the web root, writable by the web server only.
STORAGE_DIR=storage
LEDGER_DIR=storage/ledger

# ---- Contact form ------------------------------------------------------------------------------------------
# Official address that receives enquiries, and the one for the Retreat form (falls back to CONTACT_TO).
CONTACT_TO=anamayashram@gmail.com
CONTACT_TO_RETREAT=anamayvedicretreat@gmail.com
# Spam guards: milliseconds a visitor needs to fill the form, and messages per address per window.
CONTACT_MIN_FILL_MS=2000
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=600

# smtp sends real mail. log (development only) writes each message to a file in STORAGE_DIR/mail.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, usually port 587), ssl (usually port 465) or none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender shown on every message. Use an address the SMTP account may send from.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Anāmay Ashram website

# ---- Donations ---------------------------------------------------------------------------------------------
# razorpay, or leave empty to switch the API's donation endpoints off. (fake exists for development only.)
DONATION_PROVIDER=
# Keys from the Razorpay dashboard. Test keys (rzp_test_...) are required unless APP_ENV=production, live keys
# (rzp_live_...) are required in production. The webhook secret is the one typed in the dashboard's webhook form.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Amounts in rupees. These override config/donation.php.
DONATION_MIN_AMOUNT=100
DONATION_MAX_AMOUNT=500000
DONATION_PRESETS=500,1100,2100,5100
# Orders per visitor address per window (seconds)
DONATION_RATE_LIMIT=10
DONATION_RATE_WINDOW=3600
