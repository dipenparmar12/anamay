# Local settings for building the website (copy to website/.env; never commit it).
# The deployment sets the same names as workflow variables (see docs/configuration.md). All are optional.

# Public address of the site, without a trailing slash. Used for canonical links, the sitemap and link previews.
SITE_URL=http://localhost:8080
# Address of the contact and donation API (server/). Empty: the enquiry form opens the visitor's e-mail app instead.
API_BASE_URL=http://localhost:8000
# How donations are taken: legacy (link to the old donation page), button (Razorpay payment button) or native (our own form, needs the API).
DONATION_MODE=button
# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX. Empty: no analytics.
GA4_ID=
# true: also build pages for the old WordPress addresses (content/redirects.csv). The deployment does this; locally it only adds folders.
LEGACY_REDIRECTS=false
# images.mjs only: where the original photographs are (default: the uploads folder of the offline copy of the old site).
IMAGE_SOURCE_DIR=
